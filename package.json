{
  "name": "design-review-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Chrome extension for design review of live web pages: pick elements like DevTools Inspect, write what is wrong, export an HTML or PDF report.",
  "homepage": "https://github.com/rstp-god/design-review-extension#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rstp-god/design-review-extension.git"
  },
  "bugs": {
    "url": "https://github.com/rstp-god/design-review-extension/issues"
  },
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:content": "vite build -c vite.content.config.ts --watch",
    "build": "tsc -b && vite build && vite build -c vite.content.config.ts",
    "build:e2e": "tsc -b && VITE_E2E=1 vite build && VITE_E2E=1 vite build -c vite.content.config.ts",
    "bundle:report": "node scripts/bundle-report.mjs",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e:local": "playwright test --project=chromium-mac",
    "test:e2e:update-snapshots": "playwright test --project=chromium-mac --update-snapshots",
    "test:e2e:ci": "xvfb-run -a playwright test --project=chromium-ci",
    "test:e2e:update-snapshots:ci": "xvfb-run -a playwright test --project=chromium-ci --update-snapshots",
    "postinstall": "husky"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@medv/finder": "^4.0.2",
    "i18next": "^26.5.10",
    "idb": "^8.0.4",
    "lucide-react": "^1.61.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.1.8",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@crxjs/vite-plugin": "^2.4.11",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/chrome": "^0.3.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "4.1.3",
    "fake-indexeddb": "^6.2.6",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-zip-pack": "^1.2.4",
    "vitest": "4.1.3"
  }
}
